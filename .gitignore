# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Browser and judge output is reproducible run state. Keep maintained
# conclusions in Markdown, and keep raw captures out of Git.
docs/evidence/**/*.png
docs/evidence/**/*.json
docs/evidence/**/measurements*.md
docs/evidence/**/scores.md
docs/evidence/final-round*.md
docs/evidence/l[0-9]*/
docs/evidence/l[0-9]*-*.md

# Agent convergence ledgers are disposable run state, not project documentation.
/*-loop.log.md
