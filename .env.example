# Server-only. Production points to the supplied Neon database.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Automated tests refuse any database whose name does not end in `_test`.
TEST_DATABASE_URL=postgresql://localhost:5432/kyle_financial_test

# Demo seeding is explicit and never runs during app startup.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=replace-with-a-local-demo-password

# Proxies in front of the app whose `x-forwarded-for` entries can be trusted.
# The rate limiter keys on the address the outermost trusted proxy observed,
# counting back from the right, because everything to its left is caller-supplied.
# Vercel and most single-proxy hosts are 1. Never set this to 0.
TRUSTED_PROXY_HOPS=1
